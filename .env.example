# capture-scheduler の設定。**このファイルが .env の唯一の出どころ** —— setup.sh はこれを写すだけ。
#
# 書いてよい行は 2 つの形だけ:
#   NAME=value    値がある
#   #NAME=value   既定値がある。変えたいときだけコメントを外す
#
# 生の `NAME=` (空文字) は書かないこと。空文字は「無い」より悪い ——
# 既定値を潰したうえで、名前が一言も出ないエラーになる。
#
# **`.env.local` は別。** あれは道具が書く生成物で (`pnpm run windmill:bootstrap`)、
# node が `.env` の後に読むので、名前が重なればあちらが勝つ。手で書くのは `.env` だけ。

# ── Windmill ────────────────────────────────────────────────────────────

# Windmill の URL。host 側の道具 (この repo の scripts/) が使う。
#WINDMILL_URL=http://127.0.0.1:8000

# workspace の id。scripts/bootstrap.ts が無ければ作る。
#WINDMILL_WORKSPACE=crawler

# bootstrap が作った API token。**`pnpm run windmill:bootstrap` が `.env.local` に書く。**
# 起動前には決まらないので、ここには名前しか無い —— 書き写す作業は無い。
#WINDMILL_TOKEN=

# Windmill の初回ログイン。上流の既定のまま。
#WINDMILL_EMAIL=admin@windmill.dev
#WINDMILL_PASSWORD=changeme

# ── capture-ledger ──────────────────────────────────────────────────────────────

# **コンテナから見た** capture-api の URL。flow の段の報告がここへ届く。
# 書かなければ default ネットワークの gateway から組む (`container network inspect default` の
# status.ipv4Gateway)。network を作り直すと変わるので決め打ちしない ——
# windmill:capture-ledger-token がその場で読むので、変わったらそれをやり直す。
# capture-ledger 側で CAPTURE_LEDGER_API_HOST=0.0.0.0 にしていないと、ここには届かない。
#CAPTURE_LEDGER_API_URL=http://<default ネットワークの gateway>:7070

# capture-ledger の置き場。windmill:capture-ledger-token と doctor・e2e が、向こうの引き渡しファイル
# (.dev/idp.env。capture-ledger の idp:bootstrap が書く) を読み、Windmill の flow が capture-ledger に名乗る資格
# (手元の Floci の app client の ID と secret) を変数 u/admin/ledger_client に入れる。
# トークンそのものは入れない —— Cognito の access token は最長 1 日なので、flow が段ごとに取る。
# capture-ledger の dev:up はこれを使わず、場所を引数で渡す (worktree でも届くように)。
#CAPTURE_LEDGER_DIR=../capture-ledger

# コンテナから見た browserhive のエンドポイント (URL。BrowserHive v12 から HTTP)。カンマ区切りで複数 ——
# browser 1 台にエンドポイント 1 つなので、並列に取り込む数だけ並ぶ。Windmill の script が空いているエンドポイントを選ぶ。
# TLS か平文かは scheme が言う (https:// なら下の CA で検証する)。
# **変数に入れて渡す** —— Windmill は schema の既定値を UI からの実行にしか埋めないので、
# webhook で起こすと引数は素通りになる。
#CAPTURE_LEDGER_BROWSERHIVE_ENDPOINTS=http://browserhive-1.capture-ledger:50051,http://browserhive-2.capture-ledger:50051
# browserhive のエンドポイントが https:// のときの CA 証明書 (PEM の中身)。空 = 平文のエンドポイント。
#CAPTURE_LEDGER_BROWSERHIVE_TLS_CA_PEM=

# ── ts-compile-service ───────────────────────────────────────────────────────

# コンテナから見た ts-compile-service (TS のスクリプトを型検査して JS にする)。flow の compile の段が
# 変数 u/admin/ts_compile_url から読む。既定は docker-compose.yml の service ts-compile。
# URL の形で書くこと —— 素のサービス名を値にすると container-compose が IP に書き換える。
#TS_COMPILE_URL=http://ts-compile.capture-scheduler:8080
